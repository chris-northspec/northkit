# NorthKit settings. Run sh deploy/install.sh to make deploy/.env with fresh secrets,
# or copy this file to deploy/.env and fill in every blank value yourself.
# Never commit deploy/.env. Generate each password and key separately, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ---- PostgreSQL server (the db container) ----
# Superuser for the database container. Only the migrate step, backups and restores use it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Database name.
NORTHKIT_DB_NAME=northkit
# Port the database listens on, on this machine only (127.0.0.1). 5450 avoids clashing with a
# local PostgreSQL or another NorthSpec product on the same machine.
NORTHKIT_DB_HOST_PORT=5450

# ---- Where tools run outside Docker find the database (pnpm db:*, tests) ----
# Inside Docker these are overridden to db:5432.
NORTHKIT_DB_HOST=localhost
NORTHKIT_DB_PORT=5450

# ---- Database roles (created by the first migration; passwords set by the migrate step) ----
# Password for northkit_app, the role the web app and worker use. It can never bypass row-level security.
NORTHKIT_APP_DB_PASSWORD=
# Password for northkit_readonly, for Power BI or Excel reporting. This role sees EVERY site's data
# (read-only), so give it to your own staff only. Leave blank and the role can't sign in.
NORTHKIT_READONLY_DB_PASSWORD=

# ---- Application ----
# One-time code the first-run set-up screen asks for. deploy/install.sh makes it and shows it
# once; it stops working when the first administrator exists. Blank = set-up locked.
NORTHKIT_SETUP_CODE=
# 32 random bytes, base64. Encrypts two-factor secrets at rest. Changing it turns off everyone's
# two-factor sign-in.
NORTHKIT_SECRET_KEY=
# A session ends after this many minutes without a request (default 720: one shift).
NORTHKIT_SESSION_IDLE_MINUTES=720
# A session ends this many hours after sign-in, however active.
NORTHKIT_SESSION_ABSOLUTE_HOURS=24
# Keep true: session cookies then travel over HTTPS only (browsers also allow http://localhost).
# Set false only on a test machine without HTTPS.
NORTHKIT_COOKIE_SECURE=true
# The address people reach NorthKit on, e.g. https://kit.example.co.uk. Labels, QR codes and email
# links use it. Blank: the address the page was opened on.
NORTHKIT_PUBLIC_URL=
# Port the web app is published on.
NORTHKIT_WEB_HOST_PORT=3030

# ---- Backups (deploy/backup.sh) ----
# Folder on this machine the nightly dump is written to, and how many days of dumps to keep.
NORTHKIT_BACKUP_DIR=./backups
NORTHKIT_BACKUP_KEEP_DAYS=14

# ---- Development only (pnpm db:seed). Leave blank on a live install ----
# Email and password for the fictional admin the seed creates. The seed refuses to run without a password.
SEED_ADMIN_EMAIL=admin@northkit.test
SEED_ADMIN_PASSWORD=

# ---- Demo link (NorthSpec's own demo PC only; see docs/demo-link.md) ----
# Leave blank on every customer install. Demo PC only, under `pnpm dev`: this address is
# accepted as well as the one NorthKit runs on, a tunnel connecting from this machine
# (127.0.0.1 or ::1) is trusted to name the visitor (Cf-Connecting-Ip), and a "Demo,
# fictional data" strip shows on that address only. The production build and the Docker
# web container refuse to start while it is set.
#NORTHKIT_DEMO_ORIGIN=https://northkit-demo.example
# Password for the shared demo Administrator made by `pnpm demo:user` (12 characters or
# more). Demo or development databases only; never commit it.
#DEMO_SHARED_PASSWORD=
