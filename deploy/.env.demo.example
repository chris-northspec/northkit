# The demo link's settings (NorthSpec's own demo PC only; docs/demo-link.md).
# Copy to deploy/.env.demo (git-ignored) and fill in. Only `pnpm demo` and `pnpm demo:docker`
# read this file: the install's deploy/.env never needs any of it, and the normal Docker
# install still refuses to start if NORTHKIT_DEMO_ORIGIN is in deploy/.env. Never on a
# customer install. Generate each secret separately, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ---- Both commands ----
# The tunnel's address. The app accepts this address as well as localhost, trusts a tunnel
# connecting from this machine (127.0.0.1 or ::1) to name the visitor (Cf-Connecting-Ip),
# and shows a thin "Demo, fictional data" strip on that address only.
NORTHKIT_DEMO_ORIGIN=https://northkit-demo.example
# Labels, QR codes and email links point at the demo address.
NORTHKIT_PUBLIC_URL=https://northkit-demo.example
# The fictional demo company (pnpm db:seed-demo). Must be a demo or development database name.
NORTHKIT_DB_NAME=northkit_demo_test
# The browser sees HTTPS through the tunnel; localhost still works.
NORTHKIT_COOKIE_SECURE=true
# Port the demo is served on (the tunnel's service URL is http://localhost:<port>).
NORTHKIT_DEMO_PORT=3030
# Password for the shared demo Administrator demo@northspec.test (12 characters or more).
# From Bitwarden; never commit it.
DEMO_SHARED_PASSWORD=

# ---- `pnpm demo` (the development server) ----
# It reads the database passwords and secret key from deploy/.env, as `pnpm dev` does.

# ---- `pnpm demo:docker` (the Docker demo profile: its own database and volumes) ----
# Its own PostgreSQL, so nothing here touches the normal install's database or files.
DEMO_POSTGRES_PASSWORD=
DEMO_APP_DB_PASSWORD=
# 32 random bytes, base64. Encrypts two-factor secrets in the demo database.
DEMO_SECRET_KEY=
# Password for every seeded demo person (demo.admin@northkit.test and so on), for
# `pnpm db:seed-demo`. Demo or development databases only.
SEED_DEMO_PASSWORD=
